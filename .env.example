# Copy this file to .env and fill in real local values.
# .env is git-ignored; this example file is committed and contains no secrets.

NODE_ENV=development
PORT=3003
DATABASE_URL=postgresql://bcis_user:change_this@localhost:5432/bcis_db
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
# Browser origins allowed to call the API, comma-separated.
# Development: the Vite dev server. A packaged Electron renderer loads from
# file:// and reports its origin as the literal string "null", so a production
# server that must accept installed clients uses:
#   CORS_ORIGIN=http://localhost:5173,null
CORS_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=12

# Phase 9 §4 — API rate limiting. Requests per minute per client IP.
RATE_LIMIT_MAX=100
# The stricter ceiling applied to POST /api/auth/login, per client IP.
LOGIN_RATE_LIMIT_MAX=10

# Optional — per-account failed-login lockout (S5-5). The bootstrap defaults can
# be changed at runtime in system_settings (login_lockout_threshold,
# login_lockout_cooldown_minutes) without editing this file.
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_COOLDOWN_MINUTES=15

# Optional — how long the database-resolved permission matrix is cached before it
# is refreshed from role_permissions (defaults to 30000 ms).
RBAC_PERMISSION_CACHE_TTL_MS=30000

# Optional — where application backups are written (defaults to ./backups).
BACKUP_DIR=backups

# Optional — where GCash proof screenshots are stored (defaults to ./uploads).
UPLOADS_DIR=uploads

# Optional — the bootstrap Administrator created by `pnpm db:seed` on a database
# that has no such user. The seed never resets an existing account, so changing
# the password after the first login is enough. CHANGE IT IMMEDIATELY.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@1234!

# Optional — the React renderer falls back to http://localhost:3003 when unset.
# An installed client can also override this at run time with config.json; see
# docs/deployment/README.md.
VITE_API_BASE_URL=http://localhost:3003