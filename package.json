{
  "name": "bcis-system",
  "version": "0.1.0",
  "private": true,
  "description": "BCIS Subscription Billing and Collection System — Electron + React client, Fastify API, PostgreSQL",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:web": "concurrently -n server,client -c blue,green \"pnpm dev:server\" \"pnpm dev:web:client\"",
    "dev:server": "pnpm --filter server dev",
    "dev:client": "pnpm --filter client dev",
    "dev:web:client": "pnpm --filter client dev:web",
    "start": "pnpm --filter server start",
    "build": "pnpm -r --if-present build",
    "build:installer": "pnpm --filter client package:win",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "pnpm --filter server db:seed",
    "db:seed:demo": "pnpm --filter server db:seed:demo",
    "db:reset-passwords": "pnpm --filter server db:reset-passwords",
    "db:reset": "pnpm --filter server db:reset",
    "db:fresh": "pnpm --filter server db:reset",
    "db:studio": "drizzle-kit studio",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "submission": "bash scripts/build-submission.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "verify:gui": "electron --no-sandbox scripts/verify-electron-gui.cjs",
    "screenshots": "electron --no-sandbox scripts/capture-ui-screenshots.cjs",
    "test:e2e": "pnpm --filter client test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "concurrently": "^9.1.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}
