# Dependencies
node_modules/

# Environment files — only .env.example is committed
.env
.env.*
!.env.example

# Build output
dist/
out/
build/
*.tsbuildinfo

# Tooling caches
.eslintcache
.prettiercache
coverage/

# Playwright end-to-end output (S10-1) — traces and reports are regenerated, not committed
apps/client/test-results/
playwright-report/

# Logs
*.log
npm-debug.log*

# OS noise
.DS_Store
Thumbs.db
*:Zone.Identifier
# Harness/session state — committed config lives at .pi/settings.json and .pi/skills/
.pi/tasks/
.pi/npm/
.pi/git/
.pi/cache/
.pi/sessions/

# Impeccable — machine-installed/updatable skill and its live runtime state
.agents/skills/impeccable/
.impeccable/

# Uploaded GCash proof screenshots live on the server, never in git
uploads/

# Phase 10 artifacts — database backups and the assembled submission folder
backups/
submission/

# Electron installer output (built on Windows with `pnpm build:installer`)
apps/client/installer/
